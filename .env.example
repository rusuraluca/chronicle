# Chronicle local / compose defaults
POSTGRES_USER=chronicle
POSTGRES_PASSWORD=chronicle
POSTGRES_DB=chronicle
DATABASE_URL=postgres://chronicle:chronicle@postgres:5432/chronicle
REDIS_URL=redis://redis:6379
CHRONICLE_HTTP_ADDR=0.0.0.0:8080
CHRONICLE_GRPC_ADDR=0.0.0.0:50051
RUST_LOG=chronicle_server=info,tower_http=info,info
VITE_API_BASE=http://localhost:8080
