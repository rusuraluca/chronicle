# syntax=docker/dockerfile:1.7

FROM rust:1.97-bookworm AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY proto ./proto
COPY migrations ./migrations

RUN cargo build --release -p chronicle-server -p chronicle-cli \
    && cp target/release/chronicle-server /usr/local/bin/chronicle-server \
    && cp target/release/chronicle /usr/local/bin/chronicle

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 chronicle

COPY --from=builder /usr/local/bin/chronicle-server /usr/local/bin/chronicle-server
COPY --from=builder /usr/local/bin/chronicle /usr/local/bin/chronicle
COPY migrations /app/migrations

USER chronicle
WORKDIR /app
ENV RUST_LOG=chronicle_server=info,info
EXPOSE 8080 50051
ENTRYPOINT ["/usr/local/bin/chronicle-server"]
